{
  "fullscreen": false,
  "no_window_decoration": false,
  "floating": false,
  "fullscreen_mode": "current-screen",
  "width": 1280,
  "height": 850,
  "title": "SharpShot — Annotate",
  "app_id": "io.github.sharpshot.SharpShot",
  "input_scale": 1.0,
  "zoom_factor": 1.0,
  "pan_step": 50.0,
  "text_move": 1.0,
  "initial_tool": "smart",
  "primary_highlighter": "block",
  "stylesheet": null,
  "default_fill": false,
  "default_round_caps": true,
  "corner_radius": 0.0,
  "annotation_size_factor": 1.0,
  "brush_smoothing": 0,
  "font_family": "Sans",
  "font_style": "Regular",
  "font_fallback": ["Noto Sans", "DejaVu Sans"],
  "palette": ["#F59B34", "#F45360", "#79C554", "#36C6CA", "#A987ED", "#F3F6F7"],
  "custom_colors": ["#1E1E2E", "#FFEB3B80"],
  "hide_toolbars": false,
  "focus_toggle_toolbars": false,
  "output_filename": "~/Pictures/Screenshots/sharpshot-%Y-%m-%d_%H-%M-%S.png",
  "auto_copy": false,
  "save_after_copy": false,
  "early_exit": [],
  "copy_command": ["wl-copy", "--type", "image/png"],
  "on_enter": ["copy"],
  "on_escape": [],
  "on_right_click": [],
  "keybinds": {
    "highlighter": "<Ctrl><Shift>h",
    "save-as": "<Ctrl><Shift>s",
    "color-1": "<Alt>1"
  },
  "disable_notifications": true,
  "notification_thumbnail": false
}
